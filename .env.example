
# LINE Messaging API
CHANNEL_SECRET=
CHANNEL_ACCESS_TOKEN=

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# LINE自動返信のON/OFF
# false = 停止
# true = 自動返信開始
BOT_ENABLED=false

# 当日朝9時までWebフォーム予約を許可するか
# false = 当日は電話案内
# true = 朝9時までフォーム案内
SAME_DAY_FORM_UNTIL_9=false

# Renderのポート番号
PORT=3000
